# 应用配置
APP_NAME=数学建模比赛管理系统
API_PREFIX=/api
DEBUG=true

# 数据库：初版用 SQLite，生产换 PostgreSQL
# postgresql+asyncpg://user:pass@localhost:5432/mmcm
DATABASE_URL=sqlite+aiosqlite:///./data/mmcm.db

# JWT
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 文件存储：local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data/uploads

# 上传限制
MAX_UPLOAD_BYTES=52428800
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.doc,.zip,.rar,.7z,.xlsx,.csv,.py,.md,.txt

# 跨域（前端开发服务器）
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 是否在启动时写种子数据
SEED_ON_STARTUP=true
