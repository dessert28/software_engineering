@startuml
title 数学建模论文评审与优化服务平台——用例图
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

actor 用户 as User
actor 学生 as Student
actor 教师 as Teacher
actor 运营人员 as Operator
actor "模型服务" as Model

User <|-- Student
User <|-- Teacher
User <|-- Operator

rectangle "数学建模论文评审与优化服务平台" {
  usecase "上传并解析论文" as UC1
  usecase "校验文件与生成指纹" as UC1a
  usecase "创建评审任务" as UC2
  usecase "选择评审服务" as UC2a
  usecase "绑定已发布量表" as UC2b
  usecase "执行七阶段论文评审" as UC3
  usecase "读取模型配置" as UC3a
  usecase "保存阶段结果" as UC3b
  usecase "查看证据与优化建议" as UC4
  usecase "定位原文证据块" as UC4a
  usecase "编辑优化建议" as UC4b
  usecase "提交修改稿复审" as UC5
  usecase "匹配历史问题" as UC5a
  usecase "导出评审报告" as UC6
  usecase "管理评价量表" as UC7
  usecase "发布量表版本" as UC7a
  usecase "查看任务与审计记录" as UC8
  usecase "解析失败处理" as EX1
  usecase "证据不足提示" as EX2
  usecase "模型调用失败重试" as EX3
}

Student --> UC1
Student --> UC2
Student --> UC4
Student --> UC5
Student --> UC6
Teacher --> UC1
Teacher --> UC2
Teacher --> UC4
Teacher --> UC5
Teacher --> UC6
Teacher --> UC7
Operator --> UC7
Operator --> UC8
Model --> UC3

UC1 .> UC1a : <<include>>
UC2 .> UC2a : <<include>>
UC2 .> UC2b : <<include>>
UC3 .> UC3a : <<include>>
UC3 .> UC3b : <<include>>
UC4 .> UC4a : <<include>>
UC4b .> UC4 : <<extend>>
UC5 .> UC5a : <<include>>
UC6 .> UC4 : <<include>>
EX1 .> UC1 : <<extend>>
EX2 .> UC4 : <<extend>>
EX3 .> UC3 : <<extend>>

UC7a .> UC7 : <<extend>>
note right of UC3
七阶段：问题识别、问题表述、假设、
模型构造、求解、代码实现、结果分析
end note
@enduml
